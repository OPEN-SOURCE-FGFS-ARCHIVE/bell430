<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <path>cyclic.ac</path>

<animation>
		<type>rotate</type>
		<object-name>cyclic</object-name>
		
		
		<property>controls/flight/elevator</property>
		<factor>15</factor>
		<center>
			<x-m>-0.05</x-m>
			<y-m>0</y-m>
			<z-m>0.15</z-m>
		</center>
		<axis><y>-1</y></axis>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>cyclic</object-name>
		
		<property>controls/flight/aileron</property>
		<factor>15</factor>
		<center>
			
			<x-m>-0.05</x-m>
			<y-m>0</y-m>
			<z-m>0.15</z-m>
		
		</center>
		<axis><x>-1</x></axis>
	</animation>
	


</PropertyList>

