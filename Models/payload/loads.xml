<?xml version="1.0"?>

<PropertyList>
	
	
<animation>
        <type>range</type>
        <min-m>0</min-m>
        <max-m>500</max-m>
    </animation>

<model>
		<name>Pylons</name>
		<path>Aircraft/bell430/Models/payload/pylons.xml</path>
		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
			<pitch-deg>0.0</pitch-deg>
		</offsets>
	</model>	

  <model>
		<name>Executive</name>
		<path>Aircraft/bell430/Models/payload/executive.xml</path>
		<offsets>
			<x-m>0</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>0 </z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Executive</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Executive</value>
        </equals>
     	 
    </condition>
	
	
  </animation>	



  <model>
		<name>Passenger</name>
		<path>Aircraft/bell430/Models/payload/passenger.xml</path>
		<offsets>
			<x-m>0</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>0</z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Passenger</object-name>      
    <condition>
    
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Passenger</value>
        </equals>
       
    </condition>

	  </animation>	
 


  
    <model>
		<name>Basic Airframe</name>
		<path>Aircraft/bell430/Models/payload/basic.xml</path>
		<offsets>
			<x-m>0</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>0 </z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Basic Airframe</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Basic Airframe</value>
        </equals>
     	 
    </condition>
	
	
  </animation>	



 <model>
		<name>Law Enforcement</name>
		<path>Aircraft/bell430/Models/payload/law.xml</path>
		<offsets>
			<x-m>0</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>0 </z-m>
			<pitch-deg>0</pitch-deg>
			<heading-deg>0</heading-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Law Enforcement</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Law Enforcement</value>
        </equals>
       
    </condition>
  </animation>


  <model>
		<name>Medivac</name>
		<path>Aircraft/bell430/Models/payload/medivac.xml</path>
		<offsets>
			<x-m></x-m>
            <y-m>  0.00000 </y-m>
            <z-m></z-m>
			<pitch-deg>0</pitch-deg>
			<heading-deg>0</heading-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Medivac</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Medivac</value>
        </equals>
       
    </condition>
  </animation>


  <animation>
  <type>select</type>
  <object-name>pylon.C</object-name>  
  <condition>
  <or>
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Executive</value>
   </equals>
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Law Enforcement</value>
   </equals>
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Medivac</value>
   </equals>
   
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Passenger</value>
   </equals>
   
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Basic Airframe</value>
   </equals>
  
   
   
  </or>
  </condition>
 </animation>

</PropertyList>
