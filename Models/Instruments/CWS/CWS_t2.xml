<?xml version="1.0"?>

<PropertyList>
  <!--  Central Warning System -->
  <path>cws.ac</path>



  <!-- Cautions-->
  <animation>
    <type>select</type>
    <object-name>fuel</object-name>
     <condition>

	<less-than>
      <property>consumables/fuel/total-fuel-gals</property>
	  <value>60</value>
	  </less-than>
	
	
    </condition>
  </animation>
    
 <animation>
    <type>select</type>
    <object-name>fuelp</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/fuelp</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>fuelf</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/fuelf</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>GEN</object-name>
    <or>
			<equals>
				<property>controls/electric/engine[1]/generator</property>
						<value>false</value>
					</equals>
							
			 <equals>
      <property>controls/electric/engine/generator</property>
						<value>false</value>
	   </equals>
</or>	   
  </animation>
    
 <animation>
    <type>select</type>
    <object-name>batt</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/batt</property>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>pitot</object-name>
    <condition>
      <greater-than>
          <property>sim/failure-manager/systems/pitot/failure-level</property>
          <value>0.3</value>
        </greater-than>
		
		
 
        <and>
          <less-than>
            <property>environment/temperature-degc</property>
            <value>4.0</value>
          </less-than>

          <not>
            <property>controls/anti-ice/pitot-heat</property>
			<value>true</value>
          </not>
		  
        </and>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>horn</object-name>
    <equals>
      <property>controls/electric/horn</property>
	  <value>true</value>
	  </equals>
  </animation>

  <animation>
    <type>select</type>
    <object-name>door</object-name>
     <or>
		         <equals>
                 <property>sim/model/bo105/doors/door[0]/position-norm</property>
	            <value>1</value>
	            </equals>
		
		         <equals>
                 <property>sim/model/bo105/doors/door[1]/position-norm</property>
	            <value>1</value>
	            </equals>
				
				 <equals>
                 <property>sim/model/bo105/doors/door[2]/position-norm</property>
	            <value>1</value>
	            </equals>
				
				 <equals>
                 <property>sim/model/bo105/doors/door[3]/position-norm</property>
	            <value>1</value>
	            </equals>
				
				
		
	   </or>
  </animation>

<animation>
    <type>select</type>
    <object-name>instlight</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/instlight</property>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>mgbtemp</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/mgbtemp</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>p2ovht</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/p2ovht</property>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>gov</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/gov</property>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>engchip</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/engchip</property>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>mgbchip</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/mgbchip</property>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>tgbchip</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/tgbchip</property>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>servo</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/servo</property>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>hydr</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/hydr</property>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>LIMITwarn</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/limit</property>
    </condition>
  </animation>


  <!-- Warnings -->
  <animation>
    <type>select</type>
    <object-name>engp</object-name>
    <condition>
	<or>
     <less-than>
        <property>engines/engine/n2-rpm</property>
        <value>18083</value>
      </less-than>
	  <less-than>
        <property>engines/engine[1]/n2-rpm</property>
        <value>18083</value>
      </less-than>
	  </or>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>mgbp</object-name>
    <condition>
    <less-than>
      <property>rotors/gear/mgb-oil-pressure-bar</property>
	  <value>1.1</value>
	  </less-than>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>engfire</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/engfire</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>batttemp</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/battemp</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>gov.001</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/redgov</property>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>twtgrip</object-name>
    <condition>
      <and>
	<less-than>
      <property>controls/engines/engine/power</property>
	  <value>0.53</value>
	  </less-than> 
	  <not>
	  <less-than>
	        <property>engines/engine/running</property>
	   <value>false</value>
	    </less-than>
	   </not>
	   <or>
	   <less-than>
      <property>controls/engines/engine[1]/power</property>
	  <value>0.53</value>
	  </less-than>
	 
	     <not>
		 <less-than>
      <property>engines/engine[1]/running</property>
	   <value>false</value>
	    </less-than>
	   </not>
	   </or>
	   </and>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>empty</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/noideayet</property>
    </condition>
  </animation>
