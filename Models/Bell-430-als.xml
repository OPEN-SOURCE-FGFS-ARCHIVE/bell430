<?xml version="1.0"?>

<PropertyList>
	<path>bell430b.ac</path>
	
	
	<params>
		<flapA>
			<factor>0.5</factor>
		</flapA>
		<flapB>
			<factor>0.4</factor>
		</flapB>
		<flapC>
			<factor>0.3</factor>
		</flapC>
		<flapD>
			<factor>0.3</factor>
		</flapD>
		<flapE>
			<factor>0.2</factor>
		</flapE>
	</params>
	
	<!--
	<effect>
    <inherits-from>Aircraft/bell430/Models/Effects/reflect-uber</inherits-from>
   <object-name>bell430_8</object-name>
